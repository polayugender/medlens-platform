# Server
ENVIRONMENT=production
PORT=8000
SECRET_KEY=your_production_jwt_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL for production)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/medlens

# Live SMS / OTP Gateway Configuration
OTP_PROVIDER=fast2sms # Options: fast2sms, msg91, twilio, console
FAST2SMS_API_KEY=your_fast2sms_api_key

# Twilio (Optional alternative)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=your_verify_service_sid

# AI Extraction & Summary Layer
ANTHROPIC_API_KEY=your_claude_api_key
GEMINI_API_KEY=your_gemini_api_key
